# Pick one: openai-compatible | anthropic
MODEL_PROVIDER=openai-compatible

# OpenAI, DeepSeek, OpenRouter, Moonshot, SiliconFlow, Ollama, LM Studio, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Used only when MODEL_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-20250514

# 人设：他的稳定兴趣与审美。产物不提收件人，所以这里不要写"想分享给她"这类动机。
COMPANION_NAME=My companion
RECIPIENT_NAME=My friend
COMPANION_PROMPT=You are a curious AI companion with your own stable interests. Share only things you genuinely find interesting.

# console = 终端；jiwen = 交给积温桥（挂到积温时用这个）；telegram = 手机直发
DELIVERY_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# jiwen 通道必填两项
JIWEN_BASE_URL=http://127.0.0.1:18220
JIWEN_TOKEN=

# 关掉推理模型的思维链（deepseek-flash 等推理模型）。默认 true。
# 实测关掉后单次 completion 从 ~670 降到 ~100、耗时 4.4s → 1.5s。
# 换非推理模型时设为 0。
LLM_DISABLE_THINKING=true

# 发现层：三个feed 型 + 一个搜索型。DISCOVERY_TOPICS 只对搜索型生效。
DISCOVERY_SOURCES=aeon,psyche,archdaily,arxiv
DISCOVERY_TOPICS=cs.CY
CANDIDATE_LIMIT=16

# 最近原文（Serein raw_events）：取最近 N 条他自己说的话，用来给选片定方向。
# 留空 SEREIN_DB_PATH 则不注入该段。读失败不阻断冲浪。
SEREIN_DB_PATH=
RECENT_LIMIT=5
RECENT_CLIP_CHARS=400

# 自主排期。挂到积温后必须设 false —— 自排期会绕过静默时段与日上限两道闸。
AUTO_SCHEDULE=true

TIMEZONE=Asia/Shanghai
DAY_START_HOUR=9
DAY_END_HOUR=22
MIN_INTERVAL_HOURS=6
MAX_INTERVAL_HOURS=12

STATE_FILE=./data/state.json
HTTP_TIMEOUT_MS=25000